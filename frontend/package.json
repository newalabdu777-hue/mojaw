{
  "name": "school-management-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:desktop && tsc -b && vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "desktop": "electron .",
    "dist:win": "npm run build && electron-builder --win nsis",
    "dist:win:dir": "npm run build && electron-builder --win dir",
    "check:desktop": "node --check electron/main.cjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "4.3.4",
    "vite": "6.1.0",
    "typescript": "5.7.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "lucide-react": "0.468.0"
  },
  "devDependencies": {
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "electron": "35.1.5",
    "electron-builder": "26.0.12"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "org.schoolmanagement.desktop",
    "productName": "School Management System",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/main.cjs",
      "package.json"
    ],
    "asar": true,
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "School-Management-System-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
