# Development only. Never use this prototype with real student or financial data.
SCHOOL_ENVIRONMENT=development
SCHOOL_AUTH_REQUIRED=true
# Replace with a cryptographically random secret of at least 32 bytes.
SCHOOL_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
# Used only to create the first organization administrator; remove after bootstrap.
SCHOOL_BOOTSTRAP_TOKEN=replace-with-a-separate-random-secret-of-at-least-32-bytes
SCHOOL_CORS_ORIGINS=["http://localhost:5173"]
# Frontend: set VITE_AUTH_ENABLED=true to show the login screen and attach bearer tokens.
VITE_AUTH_ENABLED=true
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_DEMO_ORGANIZATION_ID=demo-organization
